# =================================================================
# CivicConnect — Environment Configuration Template
# =================================================================
# Copy this file to .env and provide your deployment-specific values.
# DO NOT commit real secrets or production credentials to source control.

# -----------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------
# Port number for the Express REST API backend
PORT=5001

# Application runtime mode: 'development' | 'production' | 'test'
NODE_ENV=development

# -----------------------------------------------------------------
# 2. Database Configuration
# -----------------------------------------------------------------
# MongoDB connection URI (Local instance or MongoDB Atlas cluster connection string)
MONGODB_URI=mongodb://localhost:27017/civicconnect

# -----------------------------------------------------------------
# 3. Authentication & Security (JWT)
# -----------------------------------------------------------------
# Secret key used for signing short-lived access JWT tokens (replace with secure random string)
JWT_SECRET=your_jwt_access_secret_key_change_in_production

# Secret key used for signing long-lived refresh JWT tokens
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production

# Expiration duration for access tokens (e.g. 15m, 1h)
JWT_EXPIRY=1h

# Expiration duration for refresh tokens (e.g. 7d, 30d)
JWT_REFRESH_EXPIRY=7d

# -----------------------------------------------------------------
# 4. AI & Multimodal Engine (Google Gemini & Fallback)
# -----------------------------------------------------------------
# Provider mode: 'gemini' for multimodal AI or 'fallback' for rule-based engine
AI_PROVIDER=fallback

# Gemini model identifier (e.g., gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
AI_MODEL=gemini-1.5-flash

# Timeout in milliseconds for AI inference requests
AI_TIMEOUT_MS=10000

# Google Gemini API Key (Required only if AI_PROVIDER is set to 'gemini')
GEMINI_API_KEY=

# -----------------------------------------------------------------
# 5. Media & Storage Provider
# -----------------------------------------------------------------
# Storage backend: 'local' (stores files in /uploads) or 'cloudinary' (cloud storage)
STORAGE_PROVIDER=local

# Cloudinary credentials (Required only if STORAGE_PROVIDER is 'cloudinary')
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------
# 6. SLA Monitoring Engine
# -----------------------------------------------------------------
# Enable automated SLA tracking & escalation engine
SLA_MONITOR_ENABLED=true

# Background check interval in minutes
SLA_MONITOR_INTERVAL_MINUTES=60

# Warning threshold hours before SLA breach
SLA_DUE_SOON_HOURS=6

# -----------------------------------------------------------------
# 7. Frontend Client & CORS
# -----------------------------------------------------------------
# Origin URL of the frontend web client for CORS headers
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------
# 8. Upload Constraints (Size Limits in MB)
# -----------------------------------------------------------------
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=25
MAX_VIDEO_SIZE_MB=50

# -----------------------------------------------------------------
# 9. Brevo Transactional Email (Citizen OTP Verification)
# -----------------------------------------------------------------
# Brevo API Key (Keep strictly in Backend, never in frontend/Vite)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@civicconnect.gov.in
BREVO_SENDER_NAME=CivicConnect Citizen Services
