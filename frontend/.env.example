# Frontend Environment Configuration
# When deployed to Vercel/Netlify, set VITE_API_URL to your deployed backend URL.
# Example: https://civicconnect-api.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# Optional: Dedicated Socket.IO URL (if different from backend base URL)
# Example: https://civicconnect-api.onrender.com
VITE_SOCKET_URL=http://localhost:5001
